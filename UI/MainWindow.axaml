<Window
        x:Class="untitled_role_finder.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Role Finder Chat">

        <Grid Background="#ffffff" ColumnDefinitions="Auto, *">
                <Border
                        Grid.Column="0"
                        Padding="10"
                        Background="#595858">
                        <Grid RowDefinitions="*, Auto">
                                <StackPanel Grid.Row="0">
                                        <TextBlock
                                                Margin="10"
                                                FontSize="24"
                                                Text="Role Finder Chat" />
                                </StackPanel>
                        </Grid>
                </Border>
                <TextBox
                        x:Name="ConversationInput"
                        Grid.Column="1"
                        Height="40"
                        Margin="20"
                        VerticalAlignment="Bottom"
                        Watermark="Type your message to start a conversation..." />
        </Grid>
</Window>
