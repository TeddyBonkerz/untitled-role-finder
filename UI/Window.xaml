<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="untitled_role_finder.MainWindow"
        Width="600" Height="400" Title="Role Finder Chat">
  <DockPanel>
    <TextBox x:Name="ChatBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top" Height="300"/>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,5,0,0">
      <TextBox x:Name="InputBox" Width="480" Height="30" Margin="0,0,5,0"/>
      <Button x:Name="SendButton" Content="Send" Width="80" Height="30"/>
    </StackPanel>
  </DockPanel>
</Window>